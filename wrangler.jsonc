{
  // Cloudflare Workers-konfig. Deploy skjer fra GitHub Actions
  // (.github/workflows/cf-deploy.yml), aldri lokalt: OpenNext bygger ikke på
  // Windows. Kontoen identifiseres med CLOUDFLARE_ACCOUNT_ID i workflowen.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colorcraft",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Ingen workers.dev-adresse: én inngang, på vårt eget domene.
  "workers_dev": false,
  // Cloudflare oppretter DNS-post og sertifikat selv. Sonen borresendigital.no
  // ligger i samme konto.
  "routes": [{ "pattern": "farger.borresendigital.no", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  // Kontoer (Better Auth). Databasen ligger i EU (jurisdiksjon eu).
  // Migreringene i migrations/ kjøres før hver deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "colorcraft-eu",
      "database_id": "d719405b-fbc4-468c-9c71-d25bc14fb773",
      "migrations_dir": "migrations",
    },
  ],
  // Ikke hemmelige. BETTER_AUTH_SECRET, RESEND_API_KEY og
  // TURNSTILE_SECRET_KEY settes med `wrangler secret put`, og
  // TURNSTILE_SITE_KEY legges her når widgeten finnes. Mangler noe, er
  // kontoene av (lib/auth.ts).
  "vars": {
    "BETTER_AUTH_URL": "https://farger.borresendigital.no",
    "AUTH_FROM_EMAIL": "ColorCraft <farger@borresendigital.no>",
  },
}
